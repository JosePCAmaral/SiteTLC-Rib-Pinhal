# =====================================================================
#  Segredos do backend — MODELO
# ---------------------------------------------------------------------
#  1. Copie este arquivo para ".env" (o .env NUNCA vai para o GitHub).
#  2. Preencha os valores.
#  3. Em produção, cadastre os MESMOS nomes no Cloudflare:
#     Workers & Pages > seu Worker > Settings > Variables and Secrets > tipo "Secret".
#
#  ⚠️ NUNCA crie variáveis começando com VITE_ para segredos:
#     o Vite coloca essas variáveis dentro do site, visíveis para qualquer um.
# =====================================================================

# Chave da API do Resend (envio dos e-mails de doação/apoio).
# Crie em: resend.com > API Keys. Sem ela, o e-mail aparece só no terminal.
RESEND_API_KEY=

# Texto aleatório e secreto usado para "embaralhar" os IPs no controle de
# envios (assim não guardamos o IP de ninguém). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_SALT=
